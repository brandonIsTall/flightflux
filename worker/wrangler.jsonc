{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightflux-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "SKY", "class_name": "SkyState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SkyState"] }],
  // Every 5 min: start the GitHub poller (src/dispatch.ts; doesn't wake the object). The first
  // run of each hour also replaces a missing or stuck alarm (that wakes the object). One cron on
  // purpose: a second "*/5" cron beside an hourly one was registered but never fired.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "GITHUB_REPO": "brandonIsTall/flightflux" },
  "observability": { "enabled": true },
  // 10 searches a minute per visitor IP, counted per Cloudflare location.
  "ratelimits": [{ "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
  // Secrets (not in this file): OPENSKY_CLIENT_ID, OPENSKY_CLIENT_SECRET, INGEST_SECRET,
  // GITHUB_DISPATCH_TOKEN (optional; starts the GitHub poller).
  // Local: copy ../.dev.vars.example to .dev.vars. Production: `npx wrangler secret put <NAME>`.
}
